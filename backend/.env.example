# Copy to backend/.env and set secrets, or use make init-local.
CAPELLE_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CAPELLE_INTERNAL_HOOK_SECRET=replace-with-an-independent-random-secret
CAPELLE_HOST=127.0.0.1
CAPELLE_PORT=8080
CAPELLE_PUBLIC_ORIGIN=http://localhost:5173
CAPELLE_AUTH_COOKIE_SECURE=false
CAPELLE_DEBUG=true
CAPELLE_SQLITE_PATH=compass.db
CAPELLE_STORE=sqlite
CAPELLE_QUEUE=memory
CAPELLE_WS_HUB=memory
# Provision agent dependencies before submitting real analysis jobs.
CAPELLE_OHRS_WORKING_DIR=../agent
CAPELLE_OHRS_WORKING_DIR_JEUGDZORG=../agent/jeugdzorg
CAPELLE_OHRS_HOME_DIR=../.agent-home
CAPELLE_OHRS_TOOLS_BIN=../.venv-agent/bin
CAPELLE_OHRS_JOBS_DIR=/tmp/compass-jobs
