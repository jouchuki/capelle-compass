# /etc/capelle-codex.env — systemd EnvironmentFile for capelle-platform.service
# Mode 0600, owner root:root. Do NOT commit filled values to git.
#
# Two populations of variables:
#   1. Static per-yuta config — filled by deploy/bootstrap-yuta.sh
#   2. Codex OAuth tokens       — filled and rotated by the TOKEN-SYNC
#      systemd timer (see deploy/systemd/capelle-codex-sync.timer).
#      Leave the CODEX_* lines with empty values here; bootstrap must not
#      hard-code them.
#
# ---- identity ---------------------------------------------------------------
CAPELLE_HOSTNAME=__HOSTNAME__

# ---- platform secrets (static per deployment) ------------------------------
CAPELLE_JWT_SECRET=__JWT_SECRET__

# ---- shared data plane ------------------------------------------------------
CAPELLE_STORE=postgres
CAPELLE_POSTGRES_DSN=__POSTGRES_DSN__
CAPELLE_QUEUE=rabbitmq
CAPELLE_RABBITMQ_URL=__RABBITMQ_URL__
CAPELLE_WS_HUB=rabbitmq
CAPELLE_CHROMA_HTTP=__CHROMA_HTTP__

# ---- presentation -----------------------------------------------------------
CAPELLE_PUBLIC_ORIGIN=__PUBLIC_ORIGIN__
CAPELLE_ADMIN_EMAILS=__ADMIN_EMAILS__
CAPELLE_SUPPORT_EMAIL=__SUPPORT_EMAIL__
CAPELLE_TRUSTED_PROXIES=__TRUSTED_PROXIES__

# ---- Codex OAuth (managed by TOKEN-SYNC — do NOT set by hand) --------------
# These three are written by /usr/local/sbin/capelle-codex-sync on a 5-minute
# timer; see deploy/scripts/install-codex-sync.sh. Leaving them blank here is
# correct: the first timer tick after bootstrap fills them in.
CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
